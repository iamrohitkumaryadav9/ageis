# Copy to .env. Nothing here is a usable secret: generate your own tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- API authentication ---------------------------------------------------------------
# Comma-separated <token>:<identity>:<role>. Roles: viewer < operator < approver.
# Only an approver can approve, reject or roll back a remediation. With no approver token
# configured, nothing can ever be executed.
AEGIS_API_TOKENS=CHANGE-ME-approver-token-000000:alice:approver,CHANGE-ME-operator-token-000000:bob:operator,CHANGE-ME-viewer-token-00000000:vera:viewer
# Require the approver to be a different person from whoever requested the investigation.
AEGIS_REQUIRE_DISTINCT_APPROVER=false

# --- Database -------------------------------------------------------------------------
AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:55432/aegis
POSTGRES_PASSWORD=aegis

# --- Local LLM (optional; AEGIS works without it) --------------------------------------
AEGIS_LLM_ENABLED=true
AEGIS_OLLAMA_BASE_URL=http://localhost:11434
AEGIS_OLLAMA_MODEL=qwen3:4b
AEGIS_OLLAMA_FALLBACK_MODEL=llama3.2:3b
AEGIS_OLLAMA_NUM_CTX=4096
AEGIS_OLLAMA_TEMPERATURE=0.1
AEGIS_OLLAMA_MAX_TOKENS=700
# Measured on an i5-10210U: one request takes 55-110 s. 120 s is tight; 180 s is comfortable.
AEGIS_OLLAMA_TIMEOUT_S=180
# Loading the model is budgeted separately (cold load took 23 s to over 2 min on 8 GB RAM).
AEGIS_OLLAMA_LOAD_TIMEOUT_S=300
AEGIS_OLLAMA_KEEP_ALIVE=2m
AEGIS_OLLAMA_MAX_RETRIES=1
AEGIS_MAX_TOOL_CALLS=5

# --- Runbook retrieval ----------------------------------------------------------------
# lexical (default) or hybrid (adds nomic-embed-text; costs a model swap on small-RAM machines)
AEGIS_RAG_METHOD=lexical

# --- Observability --------------------------------------------------------------------
AEGIS_MLFLOW_ENABLED=true
# e.g. http://localhost:4318 (or http://jaeger:4318 with `--profile tracing`); empty = in-process only
AEGIS_OTLP_ENDPOINT=
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=true
